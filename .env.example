# ============================================================================
# .env.example — 财报/招股书辅助阅读工具 环境变量模板
# 用法: cp .env.example .env 后按需修改，再 docker compose --env-file .env up --build
# ============================================================================

# ---- PostgreSQL (pgvector) ----
POSTGRES_USER=fr
POSTGRES_PASSWORD=fr_dev_pw
POSTGRES_DB=fr
POSTGRES_PORT=5432

# ---- Redis (RQ 队列) ----
REDIS_PORT=6379

# ---- MinIO (PDF 与解析产物对象存储) ----
MINIO_ROOT_USER=fr_minio
MINIO_ROOT_PASSWORD=fr_minio_pw
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=fr-pdf

# ---- Web (Next.js) ----
WEB_PORT=3000
# 开发期阅读页用本地 fixture 验证（值为 apps/web/public/fixtures 下的文件名）。
# 需同时开启 FR_ALLOW_DEV_FIXTURE=1。生产构建请勿设置 NEXT_PUBLIC_PDF_DEV_FIXTURE。
NEXT_PUBLIC_PDF_DEV_FIXTURE=sample-report.pdf
# 允许 PDF 代理回退到本地 fixture（§7.4 开发验证用，生产务必关闭为 0/不设置）
FR_ALLOW_DEV_FIXTURE=1

# ---- Worker (Python RQ) ----
RQ_QUEUE=default
# 内部入队端点鉴权令牌(BFF -> Worker), 必须一致
WORKER_API_TOKEN=dev_worker_token

# ---- AI 网关(模型可配置, 见 §7.3 / PRD 9.3; 开发期可先不填) ----
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_API_KEY=

# MiniMax Anthropic 兼容接口（Web 问答）
# LLM_API_STYLE=anthropic
# LLM_API_BASE=https://api.minimaxi.com/anthropic
# LLM_MODEL=MiniMax-M3
# LLM_API_KEY=
